{
  "app": {
    "baseUrl": "https://staging-api.navro.example.com",
    "trustProxy": true
  },
  "server": {
    "port": 3000,
    "ssl": {
      "enabled": true,
      "keyPath": "/etc/ssl/private/navro-staging.key",
      "certPath": "/etc/ssl/certs/navro-staging.crt",
      "caPath": ""
    }
  },
  "security": {
    "cors": {
      "allowedOrigins": ["https://staging.navro.example.com"],
      "allowCredentials": false,
      "maxAgeSeconds": 600
    }
  },
  "logging": {
    "level": "info",
    "pretty": false,
    "logsPath": "logs/staging"
  },
  "database": {
    "poolMax": 20,
    "ssl": {
      "enabled": true,
      "rejectUnauthorized": true
    }
  },
  "mail": {
    "smtp": {
      "host": "CHANGE_ME_SMTP_HOST",
      "port": 587,
      "secure": false
    }
  },
  "swagger": {
    "enabled": false
  },
  "pm2": {
    "instances": 2,
    "execMode": "cluster",
    "maxMemoryRestart": "1G"
  }
}
