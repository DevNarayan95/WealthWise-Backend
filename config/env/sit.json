{
  "app": {
    "baseUrl": "https://sit-api.wealthwise.example.com",
    "trustProxy": true
  },
  "server": {
    "port": 3000,
    "ssl": {
      "enabled": false,
      "keyPath": "",
      "certPath": "",
      "caPath": ""
    }
  },
  "security": {
    "cors": {
      "allowedOrigins": ["https://sit.wealthwise.example.com"],
      "allowCredentials": false,
      "maxAgeSeconds": 600
    }
  },
  "logging": {
    "level": "info",
    "pretty": false,
    "logsPath": "logs/sit"
  },
  "database": {
    "poolMax": 10,
    "ssl": {
      "enabled": true,
      "rejectUnauthorized": true
    }
  },
  "mail": {
    "smtp": {
      "host": "CHANGE_ME_SMTP_HOST",
      "port": 587,
      "secure": false
    }
  },
  "swagger": {
    "enabled": true
  },
  "pm2": {
    "instances": 2,
    "execMode": "cluster",
    "maxMemoryRestart": "768M"
  }
}
