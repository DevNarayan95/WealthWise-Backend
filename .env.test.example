# Copy to .env.test and replace every placeholder. Never commit .env.test.
# Used only by unit/integration/e2e tests and the db:test:* scripts.
# Use a dedicated database. E2E tests create and delete data in it.

# Required. PostgreSQL test database connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/navro_test_db"

# Required. At least 32 characters.
JWT_SECRET=replace-with-a-random-test-secret-of-32-plus-characters

# Required. At least 32 characters each.
API_KEY_WEB_FRONTEND=replace-with-test-web-frontend-api-key
API_KEY_MOBILE_APP=replace-with-test-mobile-app-api-key

# Required. Seed admin account created by the test seed.
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=replace-with-a-test-password
