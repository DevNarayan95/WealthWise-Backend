# Copy to .env and replace every placeholder. Never commit .env.
# Non-secret settings live in config/default.json and config/env/<APP_ENV>.json.

# Required. PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wealthwise_db"

# Required. At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-32-plus-characters

# Required. At least 32 characters each. Generate with: openssl rand -hex 32
API_KEY_WEB_FRONTEND=replace-with-web-frontend-api-key
API_KEY_MOBILE_APP=replace-with-mobile-app-api-key

# Required. Seed admin account created by prisma/seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. SMTP credentials for the mail server. Leave empty for servers that need no login
# (for example Mailpit locally). SMTP host and port live in config/env/<APP_ENV>.json.
SMTP_USERNAME=
SMTP_PASSWORD=